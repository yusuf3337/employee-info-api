{
  "info": {
    "name": "Employee Info API",
    "_postman_id": "a394ca46-c0e2-46b0-81f2-c55fc03b3eae",
    "description": "Admin JWT gerekir. Örnek akış: login → personel → maaş → transfer. DELETE sırası: transfer → maaş → personel. Transfer kayıtları gerçek banka işlemi başlatmaz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "salaryId",
      "value": "1"
    },
    {
      "key": "transferId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Giriş",
      "description": "Önce giriş isteğini çalıştırın. accessToken koleksiyon değişkeni olarak kaydedilir.",
      "item": [
        {
          "name": "Giriş",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmet@akinsql.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"token\", pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Personeller",
