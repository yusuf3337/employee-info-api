              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ayşe\",\n  \"lastName\": \"Yılmaz\",\n  \"email\": \"ayse.yilmaz@example.com\",\n  \"phone\": \"+90 555 111 2233\",\n  \"department\": \"Muhasebe\",\n  \"jobTitle\": \"Kıdemli Uzman\",\n  \"hireDate\": \"2026-10-27\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
