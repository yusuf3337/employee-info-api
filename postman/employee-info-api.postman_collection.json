              "raw": "{\n  \"employeeId\": {{employeeId}},\n  \"grossAmount\": \"45000.00\",\n  \"currency\": \"TRY\",\n  \"effectiveDate\": \"2026-10-01\",\n  \"notes\": \"Aylık brüt maaş\"\n}",
