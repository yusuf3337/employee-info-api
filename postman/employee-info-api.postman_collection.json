              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          }
        },
        {
          "name": "Personel ekle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ayşe\",\n  \"lastName\": \"Yılmaz\",\n  \"email\": \"ayse.yilmaz@example.com\",\n  \"phone\": \"+90 555 111 2233\",\n  \"department\": \"Muhasebe\",\n  \"jobTitle\": \"Uzman\",\n  \"hireDate\": \"2026-10-27\",\n  \"status\": \"active\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code < 300) pm.collectionVariables.set(\"employeeId\", pm.response.json().employee.employeeId);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Personel detayı",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
